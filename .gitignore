# secrets & runtime state — never commit
*.key
.env
.env.*
!.env.example
*.db
*.db-shm
*.db-wal
/data/

# Go
/bin/
/mangrove
/mangrovectl
*.test
*.out

# frontend
web/node_modules/
web/.vite/

# built SPA embedded via go:embed -- keep only the placeholder so a fresh
# clone can `go build` before the frontend has ever been built (see
# internal/webui/embed.go)
internal/webui/dist/*
!internal/webui/dist/.gitkeep

# playwright
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/

# misc
*.log
.DS_Store
