## Install: copy to /etc/systemd/system/mangrove.service, create the
## mangrove system user/group and /var/lib/mangrove, place secrets in
## /etc/mangrove/mangrove.env (0600, root-owned), then:
##   systemctl daemon-reload && systemctl enable --now mangrove
##
## Static-strategy deploys (internal/executor's "static" build strategy)
## need a second, world-readable directory: Caddy's file_server serves
## straight from disk, and Caddy runs as a different, unprivileged system
## user (see caddy.service) that has no business reading /var/lib/mangrove
## (the sqlite DB and master key live there, at 0700). Create it once:
##   mkdir -p /var/lib/mangrove-static && chown mangrove:mangrove /var/lib/mangrove-static && chmod 755 /var/lib/mangrove-static
## MANGROVE_STATIC_SITES_DIR below points at it explicitly rather than
## relying on config.go's default, which assumes an unsandboxed dev box.

[Unit]
Description=Mangrove PaaS control plane
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
Slice=mangrove.slice
ExecStart=/usr/local/bin/mangrove
Restart=on-failure
RestartSec=2
OOMScoreAdjust=-500

# Build fetch/extract (internal/executor/gitfetch.go) needs a writable
# os.TempDir() -- ProtectSystem=strict below makes /tmp read-only unless
# given a private, writable one.
PrivateTmp=true

# ProtectHome=true below hides the real /home, so the docker CLI's
# `$HOME/.docker/config.json` lookup gets "permission denied" instead of
# "no such file" -- which the docker CLI mishandles badly enough to
# misparse the *next* flag on its command line ("unknown shorthand flag").
# Point HOME at somewhere writable under our own ReadWritePaths instead.
Environment=HOME=/var/lib/mangrove

# Secrets (e.g. MANGROVE_RESEND_API_KEY) live here, never in this unit
# file or in git. File is optional (leading '-') so a fresh install
# without notifications configured yet still starts.
EnvironmentFile=-/etc/mangrove/mangrove.env
Environment=MANGROVE_STATIC_SITES_DIR=/var/lib/mangrove-static

# mangrove.slice's MemoryHigh=512M (see mangrove.slice) is a *soft* ceiling
# shared with caddy.service -- without a GOMEMLIMIT, the Go runtime paces
# GC off GOGC alone and won't know that ceiling exists, so heap growth can
# push the whole slice into cgroup memory throttling before Go's own GC
# would otherwise trigger. 320MiB leaves headroom under 512M for Caddy and
# OS/runtime overhead while giving the garbage collector a target to GC
# ahead of. GOGC is left at its default (100) deliberately: GOMEMLIMIT is a
# backstop, not the primary pacing knob, so normal collections stay
# CPU-cheap and only tighten under real memory pressure.
Environment=GOMEMLIMIT=320MiB

User=mangrove
Group=mangrove
# The mangrove user must be in the `docker` group to reach the daemon
# socket -- effectively root-equivalent access; there is no way around
# this for a Docker-based executor, so keep this host single-purpose.
SupplementaryGroups=docker
WorkingDirectory=/var/lib/mangrove

# Defense in depth even though the docker group grants broad access.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mangrove /var/lib/mangrove-static
ProtectHome=true

[Install]
WantedBy=multi-user.target
